{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bazecor",
  "version": "0.1.0",
  "identifier": "com.bazecor.app",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Bazecor",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["../build/logo.png", "../build/logo.icns", "../build/logo.ico"]
  }
}
